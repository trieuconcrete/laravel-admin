  `created_by` bigint unsigned NOT NULL,
  `updated_by` bigint unsigned DEFAULT NULL,
  `created_at` timestamp NULL DEFAULT NULL,
  `updated_at` timestamp NULL DEFAULT NULL,
  `deleted_at` timestamp NULL DEFAULT NULL,
  `type` enum('salary','bonus','penalty','other') COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `salary_advance_requests_request_code_unique` (`request_code`),
  KEY `salary_advance_requests_user_id_foreign` (`user_id`),
  KEY `salary_advance_requests_created_by_foreign` (`created_by`),
  KEY `salary_advance_requests_updated_by_foreign` (`updated_by`),
  CONSTRAINT `salary_advance_requests_created_by_foreign` FOREIGN KEY (`created_by`) REFERENCES `users` (`id`),
  CONSTRAINT `salary_advance_requests_updated_by_foreign` FOREIGN KEY (`updated_by`) REFERENCES `users` (`id`),
  CONSTRAINT `salary_advance_requests_user_id_foreign` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=11 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

DROP TABLE IF EXISTS `salary_details`;
CREATE TABLE `salary_details` (
  `salary_id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `employee_id` bigint unsigned DEFAULT NULL,
  `period_id` bigint unsigned NOT NULL,
  `base_salary` decimal(15,2) NOT NULL,
  `working_days` decimal(5,1) NOT NULL,
  `bonus` decimal(15,2) NOT NULL DEFAULT '0.00',
  `penalty` decimal(15,2) NOT NULL DEFAULT '0.00',
  `social_insurance` decimal(15,2) NOT NULL DEFAULT '0.00',
  `health_insurance` decimal(15,2) NOT NULL DEFAULT '0.00',
  `income_tax` decimal(15,2) NOT NULL DEFAULT '0.00',
  `other_deduction` decimal(15,2) NOT NULL DEFAULT '0.00',
  `total_salary` decimal(15,2) DEFAULT NULL,
  `net_salary` decimal(15,2) DEFAULT NULL,
  `status` enum('draft','pending','approved','paid','rejected') COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'draft',
  `payment_date` date DEFAULT NULL,
  `payment_method` enum('bank_transfer','cash','other') COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `notes` text COLLATE utf8mb4_unicode_ci,
  `created_by` bigint unsigned DEFAULT NULL,
  `approved_by` bigint unsigned DEFAULT NULL,
  `created_at` timestamp NULL DEFAULT NULL,
  `updated_at` timestamp NULL DEFAULT NULL,
  `total_allowance` decimal(15,2) NOT NULL DEFAULT '0.00',
  `total_expenses` decimal(15,2) NOT NULL DEFAULT '0.00',
