  CONSTRAINT `salary_advance_deductions_created_by_foreign` FOREIGN KEY (`created_by`) REFERENCES `users` (`id`),
  CONSTRAINT `salary_advance_deductions_salary_advance_request_id_foreign` FOREIGN KEY (`salary_advance_request_id`) REFERENCES `salary_advance_requests` (`id`) ON DELETE CASCADE,
  CONSTRAINT `salary_advance_deductions_updated_by_foreign` FOREIGN KEY (`updated_by`) REFERENCES `users` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

DROP TABLE IF EXISTS `salary_advance_requests`;
CREATE TABLE `salary_advance_requests` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `user_id` bigint unsigned NOT NULL,
  `request_code` varchar(20) COLLATE utf8mb4_unicode_ci NOT NULL,
  `request_date` datetime NOT NULL,
  `amount` decimal(15,2) NOT NULL,
  `advance_month` date NOT NULL,
