  CONSTRAINT `shipment_goods_shipment_id_foreign` FOREIGN KEY (`shipment_id`) REFERENCES `shipments` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB AUTO_INCREMENT=71 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

DROP TABLE IF EXISTS `shipment_reports`;
CREATE TABLE `shipment_reports` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `monthly` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL,
  `customer_id` bigint unsigned NOT NULL,
  `total_amount` decimal(15,2) NOT NULL,
  `created_at` timestamp NULL DEFAULT NULL,
  `updated_at` timestamp NULL DEFAULT NULL,
  `created_by` bigint unsigned DEFAULT NULL,
  `updated_by` bigint unsigned DEFAULT NULL,
  `is_finalized` tinyint(1) NOT NULL DEFAULT '0',
  PRIMARY KEY (`id`),
  UNIQUE KEY `shipment_reports_customer_id_monthly_unique` (`customer_id`,`monthly`),
  KEY `shipment_reports_created_by_foreign` (`created_by`),
  KEY `shipment_reports_updated_by_foreign` (`updated_by`),
  CONSTRAINT `shipment_reports_created_by_foreign` FOREIGN KEY (`created_by`) REFERENCES `users` (`id`) ON DELETE SET NULL,
  CONSTRAINT `shipment_reports_customer_id_foreign` FOREIGN KEY (`customer_id`) REFERENCES `customers` (`id`) ON DELETE CASCADE,
  CONSTRAINT `shipment_reports_updated_by_foreign` FOREIGN KEY (`updated_by`) REFERENCES `users` (`id`) ON DELETE SET NULL
) ENGINE=InnoDB AUTO_INCREMENT=8 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

DROP TABLE IF EXISTS `shipments`;
CREATE TABLE `shipments` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `customer_id` bigint unsigned DEFAULT NULL,
  `shipment_code` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Mã chuyến hàng',
  `contract_id` bigint unsigned DEFAULT NULL COMMENT 'ID hợp đồng',
  `origin` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Điểm đi',
  `destination` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `departure_time` datetime NOT NULL COMMENT 'Thời gian khởi hành',
  `estimated_arrival_time` datetime NOT NULL COMMENT 'Thời gian đến dự kiến',
  `cargo_weight` decimal(12,2) DEFAULT NULL,
  `cargo_description` text COLLATE utf8mb4_unicode_ci COMMENT 'Mô tả hàng hóa',
  `driver_id` bigint unsigned DEFAULT NULL COMMENT 'ID tài xế',
  `co_driver_id` bigint unsigned DEFAULT NULL COMMENT 'ID lơ xe',
  `vehicle_id` bigint unsigned DEFAULT NULL COMMENT 'ID phương tiện',
  `distance` decimal(12,2) DEFAULT NULL,
  `unit_price` decimal(12,2) DEFAULT NULL,
  `trip_count` int DEFAULT NULL,
  `crane_price` decimal(12,2) DEFAULT NULL,
  `has_crane_service` tinyint(1) DEFAULT NULL,
  `notes` text COLLATE utf8mb4_unicode_ci COMMENT 'Chú thích',
  `status` enum('pending','confirmed','in_transit','delivered','cancelled','delayed','completed') COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'pending' COMMENT 'Trạng thái chuyến hàng',
  `created_by` bigint unsigned DEFAULT NULL COMMENT 'Người tạo',
  `updated_by` bigint unsigned DEFAULT NULL COMMENT 'Người cập nhật',
  `created_at` timestamp NULL DEFAULT NULL,
  `updated_at` timestamp NULL DEFAULT NULL,
  `deleted_at` timestamp NULL DEFAULT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `shipments_shipment_code_unique` (`shipment_code`),
  KEY `shipments_contract_id_foreign` (`contract_id`),
  KEY `shipments_driver_id_foreign` (`driver_id`),
  KEY `shipments_co_driver_id_foreign` (`co_driver_id`),
  KEY `shipments_vehicle_id_foreign` (`vehicle_id`),
  KEY `shipments_shipment_code_index` (`shipment_code`),
  KEY `shipments_customer_id_foreign` (`customer_id`),
  CONSTRAINT `shipments_co_driver_id_foreign` FOREIGN KEY (`co_driver_id`) REFERENCES `users` (`id`) ON DELETE SET NULL,
  CONSTRAINT `shipments_contract_id_foreign` FOREIGN KEY (`contract_id`) REFERENCES `contracts` (`id`) ON DELETE SET NULL,
  CONSTRAINT `shipments_customer_id_foreign` FOREIGN KEY (`customer_id`) REFERENCES `customers` (`id`),
  CONSTRAINT `shipments_driver_id_foreign` FOREIGN KEY (`driver_id`) REFERENCES `users` (`id`) ON DELETE SET NULL,
  CONSTRAINT `shipments_vehicle_id_foreign` FOREIGN KEY (`vehicle_id`) REFERENCES `vehicles` (`vehicle_id`) ON DELETE SET NULL
) ENGINE=InnoDB AUTO_INCREMENT=24 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

DROP TABLE IF EXISTS `toll_fees`;
CREATE TABLE `toll_fees` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `vehicle_log_id` bigint unsigned NOT NULL COMMENT 'ID nhật ký xe',
  `station_name` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Tên trạm thu phí',
  `transaction_code` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'Mã giao dịch',
  `fee_amount` decimal(15,2) NOT NULL COMMENT 'Số tiền phí',
  `notes` text COLLATE utf8mb4_unicode_ci COMMENT 'Ghi chú',
  `created_at` timestamp NULL DEFAULT NULL,
  `updated_at` timestamp NULL DEFAULT NULL,
  `deleted_at` timestamp NULL DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `toll_fees_vehicle_log_id_index` (`vehicle_log_id`),
  CONSTRAINT `toll_fees_vehicle_log_id_foreign` FOREIGN KEY (`vehicle_log_id`) REFERENCES `car_rental_vehicle_logs` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB AUTO_INCREMENT=5 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

DROP TABLE IF EXISTS `transactions`;
CREATE TABLE `transactions` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `payment_id` bigint unsigned DEFAULT NULL COMMENT 'Reference to payments table',
  `type` enum('income','expense') COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'income: revenue, expense: cost',
  `amount` decimal(15,2) NOT NULL COMMENT 'Transaction amount',
  `category` varchar(100) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'Transaction category, e.g., Salary, Food, Shopping...',
  `description` text COLLATE utf8mb4_unicode_ci COMMENT 'Detailed description',
  `transaction_date` date NOT NULL COMMENT 'Date of transaction',
  `created_by` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT 'User who created or performed the transaction',
  `created_at` timestamp NULL DEFAULT NULL,
  `updated_at` timestamp NULL DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `transactions_payment_id_foreign` (`payment_id`),
  CONSTRAINT `transactions_payment_id_foreign` FOREIGN KEY (`payment_id`) REFERENCES `payments` (`id`) ON DELETE SET NULL
) ENGINE=InnoDB AUTO_INCREMENT=22 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

DROP TABLE IF EXISTS `users`;
CREATE TABLE `users` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `full_name` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL,
  `employee_code` varchar(20) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `username` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `email` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL,
  `birthday` date DEFAULT NULL,
  `position_id` bigint unsigned DEFAULT NULL,
  `department_id` bigint unsigned DEFAULT NULL,
  `email_verified_at` timestamp NULL DEFAULT NULL,
  `password` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL,
  `phone` varchar(12) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `id_number` varchar(20) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `address` text COLLATE utf8mb4_unicode_ci,
  `join_date` date DEFAULT NULL,
  `role` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'user' COMMENT 'admin, user, manager, staff, driver',
  `status` tinyint(1) NOT NULL DEFAULT '1',
  `avatar` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `profile_image` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `salary_base` decimal(12,2) DEFAULT NULL,
  `gender` tinyint DEFAULT NULL,
  `notes` text COLLATE utf8mb4_unicode_ci,
  `deleted_at` timestamp NULL DEFAULT NULL,
  `remember_token` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `created_at` timestamp NULL DEFAULT NULL,
  `updated_at` timestamp NULL DEFAULT NULL,
  `salary_advance_amount` decimal(15,2) DEFAULT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `users_email_deleted_at_unique` (`email`,`deleted_at`),
  UNIQUE KEY `users_employee_code_deleted_at_unique` (`employee_code`,`deleted_at`),
  UNIQUE KEY `users_username_deleted_at_unique` (`username`,`deleted_at`),
  KEY `users_employee_code_index` (`employee_code`),
  KEY `users_position_id_index` (`position_id`)
) ENGINE=InnoDB AUTO_INCREMENT=28 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

DROP TABLE IF EXISTS `vehicle_documents`;
CREATE TABLE `vehicle_documents` (
  `document_id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `vehicle_id` bigint unsigned NOT NULL,
  `document_type` varchar(50) COLLATE utf8mb4_unicode_ci NOT NULL,
  `issue_date` date DEFAULT NULL,
  `expiry_date` date DEFAULT NULL,
  `document_number` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `document_file` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `status` varchar(30) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'valid',
  `created_at` timestamp NULL DEFAULT NULL,
